# Application Info
TAURI_APP_NAME="Laravel"
TAURI_APP_IDENTIFIER=com.example.laravel
TAURI_APP_VERSION=0.1.0

# Window Settings
TAURI_WINDOW_TITLE="Laravel"
TAURI_WINDOW_WIDTH=1200
TAURI_WINDOW_HEIGHT=800
TAURI_WINDOW_RESIZABLE=true
TAURI_WINDOW_FULLSCREEN=false

# Development Server
TAURI_DEV_HOST=127.0.0.1
TAURI_DEV_PORT=8080

# FrankenPHP Settings
TAURI_FRANKENPHP_VERSION=latest
TAURI_PHP_VERSION=8.3
TAURI_PHP_EXTENSIONS=opcache,pdo_sqlite,mbstring,openssl,tokenizer,xml,ctype,json,bcmath,fileinfo

# Build Settings
TAURI_BUILD_DEBUG=false
TAURI_OBFUSCATE_CODE=false

# Code Signing (Optional)
# TAURI_SIGN_WINDOWS=false
# TAURI_SIGN_MACOS=false
# TAURI_MACOS_SIGNING_IDENTITY=
# TAURI_WINDOWS_CERTIFICATE_THUMBPRINT=
