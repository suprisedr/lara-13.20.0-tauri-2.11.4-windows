{
    "productName": "Chainbook",
    "version": "0.1.0",
    "identifier": "com.chainbook.desktop",
    "build": {
        "beforeDevCommand": "php artisan serve --port=8080",
        "beforeBuildCommand": "sh src-tauri/build-resources.sh",
        "devUrl": "http://127.0.0.1:8080",
        "frontendDist": "../desktop-frontend"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "resources/laravel",
            "resources/desktop-mcp"
        ],
        "externalBin": [
            "binaries/frankenphp"
        ],
        "copyright": "",
        "category": "DeveloperTool",
        "shortDescription": "",
        "longDescription": "",
        "macOS": {
            "signingIdentity": "-",
            "entitlements": "entitlements.plist"
        }
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Chainbook",
                "width": 1200,
                "height": 800,
                "resizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
